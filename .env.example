# -----------------------------------------------------------------------------
# Environment Variables — Bluetech Digital Ltd (rebuild)
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# NEXT_PUBLIC_-prefixed vars are bundled into client JS — never put a secret there.
# -----------------------------------------------------------------------------

# XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX WEBSITE SETTINGS XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

SITE_URL=""

# XXXXXXXXXXXXXXXXXXXX CMS LOGIN DETAILS ( WORDPRESS ) XXXXXXXXXXXXXXXXXXXXXXXXX

# CMS_URL is the production WordPress host; DEV_CMS_URL is the current
# staging/dev host. CMS_API_URL is the WPGraphQL endpoint that
# graphql/CMS/fetchCmsGraphQL.ts actually fetches from — confirm which host
# this should point at before deploying, since it currently targets the
# DEV_CMS_URL host rather than CMS_URL.
CMS_URL=""
DEV_CMS_URL=""
CMS_API_URL=""
IMAGE_DIR_URL=""

# Not currently read by any application code — present in the existing
# .env.local but unwired. Keep documented until confirmed dead or a use is
# found (e.g. an authenticated WP REST/admin call).
WORDPRESS_CMS_USERNAME=""
WORDPRESS_CMS_PASSWORD=""

# Remote patterns for next/image (config/apollo.ts removal + next.config.ts)
IMAGE_REMOTE_PATTERNS_HOSTNAME_ONE=""
IMAGE_REMOTE_PATHNAME_ONE="/**"
IMAGE_REMOTE_PATTERNS_HOSTNAME_TWO=""
IMAGE_REMOTE_PATHNAME_TWO="/**"

# XXXXXXXXXXXXXXXXXXXXXXXXXX INTERNATIONALISATION (i18n) XXXXXXXXXXXXXXXXXXXXXXX

# ------------------- Microsoft Azure AI Translator -------------------------
# Machine-translates CMS content for non-default locales. Provision a
# Translator resource in Azure; the endpoint is the global one unless the
# resource is region-pinned. Required once the i18n pipeline (Step 6 of the
# upgrade plan) is built — the pipeline fails soft to the default language
# (English) if these are unset or Azure errors.
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"

# XXXXXXXXXXXXXXXXXXXXXXXXXX OTHER INTEGRATIONS XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------- Google Tag Manager -------------------------------
NEXT_PUBLIC_GTM_ID=""

# --------------------------- Google Reviews --------------------------------
# Not currently read by any application code — present in the existing
# .env.local but no Google Reviews component/query exists yet.
GOOGLE_REVIEWS_PLACE_ID=""
GOOGLE_REVIEWS_API_KEY=""

# --------------------- Nodemailer (contact form) --------------------------
# config/nodemailer.ts builds a transporter from these, but nothing in the
# app currently calls transporter.sendMail() — the contact form
# (lib/contactForm.tsx) posts to /api/email, which doesn't exist in this repo
# yet. The email pipeline needs finishing before this is functional.
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_HOST=""

# ----------------------- Vercel platform -----------------------------------
# Not currently read by any application code.
VERCEL_SCRIPT_URL=""
